NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_URL=http://localhost:5000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/estate_db?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

MAX_FILE_SIZE=5242880

# Email (SMTP / Nodemailer for OTP)
EMAIL_USER=
EMAIL_PASS=

# CRM Sharing & Catalogues
CRM_PUBLIC_SHARE_URL=https://estatepartner.in/catalog
CRM_WEBHOOK_SECRET=your_crm_webhook_secret_key
CRM_REQUIRE_WEBHOOK_SIG=false

# WhatsApp Business Cloud API Integration
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telephony Provider (Click-to-Call & Recording)
TELEPHONY_PROVIDER=manual_adapter
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_WEBHOOK_SECRET=

# AI Call Summarization Provider
AI_PROVIDER=heuristic_engine
AI_API_KEY=
